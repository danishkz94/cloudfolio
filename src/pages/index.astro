---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    period: '2026 — now',
    company: 'lululemon',
    title: 'Senior Software Developer — DevOps',
    location: 'Vancouver, BC',
    detail: 'Building dependable developer platforms and cloud infrastructure for teams that ship at scale.',
  },
  {
    period: '2024 — 2026',
    company: 'Cornerstone OnDemand',
    title: 'Senior DevOps Engineer',
    location: 'Vancouver, BC',
    detail: 'Enabled secure, repeatable delivery across cloud environments and container platforms.',
  },
  {
    period: '2019 — 2024',
    company: 'SkyHive',
    title: 'Cloud Engineer',
    location: 'Vancouver, BC',
    detail: 'Designed multi-cloud architecture, automated deployments, and security-led platform foundations.',
  },
  {
    period: '2015 — 2019',
    company: 'Atos',
    title: 'System Engineer',
    location: 'Mumbai, India',
    detail: 'Built and reviewed enterprise systems across public-cloud and application platforms.',
  },
];

const capabilities = [
  ['Cloud', 'AWS · Azure · Google Cloud'],
  ['Platforms', 'Kubernetes · EKS · AKS · GKE · Docker · CRI-O'],
  ['Delivery', 'Terraform · GitHub Actions · Azure DevOps · CI/CD'],
  ['Security', 'IAM · encryption · SOC 2 · ISO 27001 · FedRAMP'],
  ['Reliability', 'NGINX · Apache · observability · service mesh · Istio'],
];
---

<BaseLayout title="Cloudfolio — Danish Kazi" description="Danish Kazi — Senior DevOps and Cloud Engineer.">
  <main>
    <nav class="nav shell" aria-label="Primary navigation">
      <a class="wordmark" href="#top" aria-label="Cloudfolio home">cloud<span>folio</span></a>
      <a class="nav-link" href="#contact">Let’s connect <span aria-hidden="true">↗</span></a>
    </nav>

    <section id="top" class="hero shell">
      <p class="eyebrow"><span class="status-dot"></span> Available for interesting infrastructure problems</p>
      <h1>I build infrastructure<br />that <em>ships.</em></h1>
      <div class="hero-footer">
        <p class="lede">Senior DevOps engineer and cloud architect designing secure, scalable platforms that let teams move with confidence.</p>
        <a class="round-link" href="#experience">Explore my work <span aria-hidden="true">↓</span></a>
      </div>
      <div class="orb orb-one" aria-hidden="true"></div>
      <div class="orb orb-two" aria-hidden="true"></div>
    </section>

    <section class="identity shell" aria-labelledby="identity-heading">
      <p class="section-label">01 / Currently</p>
      <div class="identity-grid">
        <h2 id="identity-heading">Danish Kazi</h2>
        <div>
          <p class="role">Senior Software Developer — DevOps<br /><span>lululemon / Vancouver, Canada</span></p>
          <p>I turn cloud complexity into durable, secure systems. Over a decade in the field has made me equally at home in architecture reviews, incident-ready platforms, and the automation that joins them.</p>
        </div>
      </div>
    </section>

    <section id="experience" class="experience shell" aria-labelledby="experience-heading">
      <div class="section-head">
        <p class="section-label">02 / Selected experience</p>
        <h2 id="experience-heading">Production is a<br /><em>team sport.</em></h2>
      </div>
      <ol class="timeline">
        {experience.map((job) => (
          <li>
            <p class="period">{job.period}</p>
            <div class="job">
              <h3>{job.company}</h3>
              <p class="job-title">{job.title} <span>· {job.location}</span></p>
            </div>
            <p class="job-detail">{job.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="capabilities shell" aria-labelledby="capabilities-heading">
      <p class="section-label">03 / Capabilities</p>
      <h2 id="capabilities-heading">Systems, not<br /><em>silver bullets.</em></h2>
      <div class="capability-list">
        {capabilities.map(([name, tools], index) => (
          <div class="capability">
            <span class="capability-number">0{index + 1}</span>
            <h3>{name}</h3>
            <p>{tools}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="architecture shell" aria-labelledby="architecture-heading">
      <p class="section-label">04 / This site</p>
      <div class="architecture-card">
        <div>
          <p class="micro-label">Architecture note</p>
          <h2 id="architecture-heading">The immutable<br />resume.</h2>
          <p>This portfolio is intentionally simple: versioned in Git, automatically deployed from main, and served at the edge.</p>
        </div>
        <div class="stack-diagram" aria-label="GitHub pushes deploy through Cloudflare Pages to a global edge network">
          <span>GitHub</span><b>→</b><span>Cloudflare Pages</span><b>→</b><span>Global edge</span>
        </div>
      </div>
    </section>

    <section id="contact" class="contact shell" aria-labelledby="contact-heading">
      <p class="section-label">05 / Contact</p>
      <h2 id="contact-heading">Let’s build something<br /><em>reliable.</em></h2>
      <div class="contact-links">
        <a href="mailto:danish_kazi@yahoo.com">danish_kazi@yahoo.com <span>↗</span></a>
        <a href="https://www.linkedin.com/in/danish-kazi-a6554213b/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a>
      </div>
    </section>
  </main>
  <footer class="shell footer">
    <span>© {new Date().getFullYear()} Danish Kazi</span>
    <span>Designed and deployed as code.</span>
  </footer>
</BaseLayout>
